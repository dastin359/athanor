.env
.env.*
__pycache__/
*.pyc
*.log
*.sqlite
*.db
.DS_Store
.venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Claude Code harness run directories (workspaces, transcripts, results).
# A relative --out-dir resolves against cwd, so a run launched from the repo
# root leaks its output here; these patterns keep that out of git.
cc_runs/
arm_*/
round*/
ablation*/
randombatch/
batchrun/
replicate/

# Staged ARC dataset. Kept at an unguessable path so a solver that wanders
# outside its workspace does not trip over ground truth sitting in plain sight;
# the suffix itself must never reach git, hence the glob.
.holdout-dataset-*/

# Test artifact: LevelGate.rulebook_path defaults to a relative "rules.json",
# so anything constructing a gate without a path writes one here.
/rules.json

# Atomic-write scratch files from tools/preserve_evidence.sh. They live beside
# their target so rename(2) stays within one filesystem; they must never be
# staged by that script's own `git add evidence`.
evidence/**/*.tmp.*
