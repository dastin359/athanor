# Claude Code harness run directories (workspaces, transcripts, results).
# A relative --out-dir resolves against cwd, so a run launched from the repo
# root leaks its output here; these patterns keep that out of git.
cc_runs/
arm_*/
round*/
ablation*/
randombatch/
batchrun/
replicate/

